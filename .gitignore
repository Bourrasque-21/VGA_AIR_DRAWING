# ==========================================
# 1. Vivado 관련 설정 (기존 설정 반영)
# ==========================================
# Vivado 쓰레기 파일 제외
**/*.cache/
**/*.hw/
**/*.ip_user_files/
**/.Xil/

# runs 폴더 내부는 전부 무시하되, .bit 파일만 예외로 관리함
# (폴더 자체는 열어둬야 git이 하위 .bit을 찾을 수 있음)
**/*.runs/**
!**/*.runs/**/
!**/*.runs/**/*.bit

# 로그 및 기록 파일 제외
*.log
*.jou
*.str

# 비바도 에러 덤프 파일
*.dmp

# 시뮬레이션 결과 파일 제외
*.wdb
*.vpb
**/sim/
**/*.sim/

# 기타 (압축파일 등) 제외
*.zip


# ==========================================
# 2. Python 관련 설정 (새로 추가됨)
# ==========================================
# 파이썬 실행 시 자동 생성되는 바이트코드 및 캐시 파일 제외
__pycache__/
*.py[cod]
*$py.class

# 파이썬 가상환경 (venv, .venv) 제외 -> 팀원마다 각자 환경이 다르므로 깃에 올리면 안 됨
.venv/
venv/
ENV/
env/

# 파이썬 테스트 및 빌드 관련 임시 파일 제외
.pytest_cache/
.mypy_cache/
build/
dist/
*.egg-info/


# ==========================================
# 3. OS 및 VS Code 시스템 파일
# ==========================================
.DS_Store
Thumbs.db
.vscode/ipch/


# ==========================================
# 4. UI 산출물
# ==========================================
# air_draw_ui.py의 SAVE 버튼이 만드는 캡처 이미지 (용량이 커서 제외)
**/python_ui/captures/